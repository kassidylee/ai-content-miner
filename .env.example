# Copy this file to .env and replace the placeholders.
# Never commit the resulting .env file.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=your-model-name
# AI_API_KEY / AI_BASE_URL / AI_MODEL_NAME are supported aliases.
CRAWL_PLATFORM=x

# Native DashScope Embedding. EMBEDDING_BASE_URL is not used in this mode.
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key-here
EMBEDDING_MODEL=text-embedding-v4
# For an OpenAI-compatible provider, use EMBEDDING_PROVIDER=openai and set:
# EMBEDDING_API_KEY=your-embedding-api-key-here
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Override only when Twitter or Reddit must use a different Embedding model.
TWITTER_EMBEDDING_MODEL=text-embedding-v4
REDDIT_EMBEDDING_MODEL=text-embedding-v4
TWITTER_EMBEDDING_ENABLED=false
TWITTER_EMBEDDING_FILTER_MODE=shadow

# Optional. Required only when the corresponding notification flow is enabled.
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# Non-secret switch. Reddit notification is enabled by default in config.py.
# Set to false here if only JSONL and reports/reddit.html are needed.
REDDIT_ENABLE_WECOM=true
